---
import Layout from '../layouts/Layout.astro';

const navItems = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Contacto', href: '#contacto' },
];

const skillGroups = [
  {
    title: 'Frontend',
    items: ['HTML', 'CSS', 'JavaScript'],
  },
  {
    title: 'Backend',
    items: ['C#', 'ASP.NET Core MVC', '.NET'],
  },
  {
    title: 'Bases de datos',
    items: ['PostgreSQL', 'SQL'],
  },
  {
    title: 'Herramientas',
    items: ['Visual Studio', 'VS Code', 'Git', 'GitHub', 'pgAdmin', 'PlantUML', 'draw.io', 'Python', 'scikit-learn'],
  },
];

const projects = [
  {
    title: 'Nativo System',
    description:
      'Sistema web para una escuela de SUP, kayak y windsurf que permite gestionar clases, reservas, instructores y el alquiler o compra de equipamiento.',
    stack: ['C#', 'ASP.NET Core MVC', 'PostgreSQL', 'HTML', 'CSS', 'JavaScript'],
    repo: 'https://github.com/lucaborghik',
    demo: '#contacto',
  },
  {
    title: 'Machine Learning',
    description:
      'Aplicación desarrollada en Python que reúne distintos algoritmos de Machine Learning para realizar tareas de regresión y clasificación utilizando datasets reales.',
    stack: ['Python', 'scikit-learn'],
    repo: 'https://github.com/lucaborghik',
    demo: '#contacto',
  },
  {
    title: 'Portfolio personal',
    description:
      'Proyecto personal para presentar mi perfil como desarrollador, mostrar mi experiencia y facilitar el contacto con posibles oportunidades laborales.',
    stack: ['Astro', 'Tailwind', 'HTML', 'CSS'],
    repo: 'https://github.com/lucaborghik',
    demo: '#inicio',
  },
];
---

<Layout title="Luca Borghi | Desarrollador de Software">
  <header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/75 backdrop-blur-xl">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Navegación principal">
      <a href="#inicio" class="text-lg font-semibold tracking-tight text-white">Luca Borghi</a>
      <div class="hidden items-center gap-6 md:flex">
        {navItems.map((item) => (
          <a href={item.href} class="text-sm text-slate-300 transition hover:text-cyan-300">{item.label}</a>
        ))}
      </div>
      <div class="flex items-center gap-3">
        <button id="theme-toggle" type="button" class="rounded-full border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-200 transition hover:border-cyan-400 hover:text-cyan-300" aria-label="Cambiar el modo de color">
          Modo claro
        </button>
        <a href="#contacto" class="inline-flex items-center rounded-full bg-cyan-400 px-4 py-2 text-sm font-medium text-slate-950 transition hover:bg-cyan-300">Contactarme</a>
      </div>
    </nav>
  </header>

  <main>
    <section id="inicio" class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:px-8 lg:py-24">
      <div class="flex flex-col justify-center">
        <span class="mb-4 w-fit rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300">
          Disponible para proyectos
        </span>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">
          Luca Borghi <span class="text-cyan-300">| Desarrollador de Software</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-slate-300">
          Estudiante de Ingeniería en Sistemas interesado en el desarrollo de aplicaciones web y en seguir creciendo como desarrollador de software.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#proyectos" class="rounded-full bg-cyan-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300">Ver proyectos</a>
          <a href="#contacto" class="rounded-full border border-slate-600 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300">Contactarme</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3 text-sm text-slate-300" aria-label="Habilidades destacadas">
          <li class="rounded-full border border-slate-700 bg-slate-900/70 px-3 py-1.5">C#</li>
          <li class="rounded-full border border-slate-700 bg-slate-900/70 px-3 py-1.5">ASP.NET Core MVC</li>
          <li class="rounded-full border border-slate-700 bg-slate-900/70 px-3 py-1.5">PostgreSQL</li>
          <li class="rounded-full border border-slate-700 bg-slate-900/70 px-3 py-1.5">Python</li>
        </ul>
      </div>

      <div class="flex items-center justify-center">
        <div class="relative w-full max-w-md rounded-[2rem] border border-slate-700 bg-slate-900/80 p-5 shadow-2xl shadow-cyan-950/30">
          <div class="absolute -inset-3 -z-10 rounded-[2.25rem] bg-cyan-500/20 blur-2xl"></div>
          <img src="/avatar.svg" alt="Retrato de Luca Borghi" class="h-full w-full rounded-[1.5rem] border border-slate-700 object-cover" />
          <div class="absolute -bottom-4 right-6 rounded-full border border-cyan-500/30 bg-slate-950/90 px-4 py-2 text-sm font-medium text-cyan-300">
            Enfoque en software y web
          </div>
        </div>
      </div>
    </section>

    <section id="sobre-mi" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">Sobre mí</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Estoy aprendiendo y construyendo soluciones con propósito.</h2>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr]">
        <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
          <p class="text-base leading-8 text-slate-300">
            Soy Luca Borghi, estudiante de Ingeniería en Sistemas con interés en el desarrollo de aplicaciones web y en seguir creciendo como desarrollador de software. Me gusta trabajar con soluciones funcionales, bien estructuradas y pensadas para resolver problemas reales.
          </p>
          <p class="mt-4 text-base leading-8 text-slate-300">
            En mis proyectos he combinado lógica de negocio, bases de datos y desarrollo web para crear sistemas útiles y con buen nivel técnico. Me entusiasma seguir aprendiendo nuevas tecnologías y mejorar cada día como profesional.
          </p>
        </div>

        <div class="space-y-6">
          {skillGroups.map((group) => (
            <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
              <h3 class="text-lg font-semibold text-white">{group.title}</h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="rounded-full border border-slate-700 bg-slate-950 px-3 py-1 text-sm text-slate-200">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="proyectos" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-10 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">Proyectos</p>
          <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Trabajos que reflejan mi interés por el desarrollo y la innovación.</h2>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {projects.map((project) => (
          <article class="group flex h-full flex-col justify-between rounded-3xl border border-slate-800 bg-slate-900/60 p-6 transition hover:-translate-y-1 hover:border-cyan-500/50">
            <div>
              <div class="mb-5 flex items-center justify-between">
                <span class="rounded-full bg-cyan-500/10 px-2.5 py-1 text-xs font-medium uppercase tracking-[0.2em] text-cyan-300">Case study</span>
                <span class="text-sm text-slate-400">2026</span>
              </div>
              <h3 class="text-2xl font-bold text-white">{project.title}</h3>
              <p class="mt-4 text-base leading-7 text-slate-300">{project.description}</p>
            </div>

            <div class="mt-6">
              <div class="flex flex-wrap gap-2">
                {project.stack.map((tech) => (
                  <span class="rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-300">{tech}</span>
                ))}
              </div>

              <div class="mt-6 flex gap-3">
                <a href={project.repo} class="text-sm font-medium text-cyan-300 hover:text-cyan-200" target="_blank" rel="noreferrer">Repositorio</a>
                <a href={project.demo} class="text-sm font-medium text-slate-200 hover:text-white" target="_blank" rel="noreferrer">Demo</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="contacto" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">Contacto</p>
          <h2 class="mt-3 text-3xl font-bold text-white">Hablemos de tu próximo proyecto.</h2>

          <ul class="mt-6 space-y-4 text-slate-300">
            <li>
              <span class="block text-sm text-slate-400">Email</span>
              <a href="mailto:lucaborghik@gmail.com" class="text-base text-cyan-300 hover:text-cyan-200">lucaborghik@gmail.com</a>
            </li>
            <li>
              <span class="block text-sm text-slate-400">GitHub</span>
              <a href="https://github.com/lucaborghik" class="text-base text-cyan-300 hover:text-cyan-200" target="_blank" rel="noreferrer">github.com/lucaborghik</a>
            </li>
            <li>
              <span class="block text-sm text-slate-400">LinkedIn</span>
              <span class="text-base text-slate-300">No disponible por el momento</span>
            </li>
          </ul>
        </div>

        <form class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6" aria-label="Formulario de contacto">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block text-sm text-slate-300">
              Nombre
              <input type="text" name="name" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none transition focus:border-cyan-400" placeholder="Tu nombre" />
            </label>
            <label class="block text-sm text-slate-300">
              Email
              <input type="email" name="email" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none transition focus:border-cyan-400" placeholder="tu@email.com" />
            </label>
          </div>

          <label class="mt-5 block text-sm text-slate-300">
            Asunto
            <input type="text" name="subject" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none transition focus:border-cyan-400" placeholder="¿Qué te gustaría hacer?" />
          </label>

          <label class="mt-5 block text-sm text-slate-300">
            Mensaje
            <textarea name="message" rows="5" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none transition focus:border-cyan-400" placeholder="Contame un poco sobre tu proyecto..."></textarea>
          </label>

          <button type="submit" class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-cyan-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300">Enviar mensaje</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950/80">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-sm text-slate-400 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <p>© 2026 Luca Borghi. Todos los derechos reservados.</p>
      <a href="#inicio" class="text-cyan-300 hover:text-cyan-200">Volver arriba</a>
    </div>
  </footer>
</Layout>
